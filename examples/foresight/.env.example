# All three values below are public browser credentials, never server secrets.
NEXT_PUBLIC_REOWN_PROJECT_ID=
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_LAYERSWAP_API_KEY=

# This origin must be allowed in the Reown, Privy, and Layerswap dashboards.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo deposits fund the connected user's OWN address, never a hard-coded recipient.
NEXT_PUBLIC_DEPOSIT_NETWORK=BASE_MAINNET
NEXT_PUBLIC_DEPOSIT_TOKEN=USDC

# Optional Privy app client identifier.
NEXT_PUBLIC_PRIVY_CLIENT_ID=
