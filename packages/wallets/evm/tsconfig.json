{
  "extends": "../tsconfig.wallet.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist/esm",
    "declarationDir": "dist/types",
    "paths": {
      "@layerswap/ui-kit": [
        "../../ui-kit/src/index.ts"
      ],
      "@layerswap/ui-kit/types": [
        "../../ui-kit/src/types/index.ts"
      ],
      "@layerswap/utils": [
        "../../utils/src/index.ts"
      ],
      "@layerswap/widget-types": [
        "../../widget/types/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "src/jsons/*.json"
  ],
  "exclude": [
    "node_modules"
  ],
  "references": [
    {
      "path": "../../ui-kit"
    },
    {
      "path": "../../utils"
    },
    {
      "path": "../../widget/types"
    }
  ]
}
