{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "emitDeclarationOnly": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "preserveSymlinks": false,
    "composite": true,
    "rootDir": "src",
    "declaration": true,
    "noEmit": false,
    "declarationDir": "dist/types",
    "outDir": "dist/esm",
    "esModuleInterop": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src",
    "src/lib/jsons/*/*.json"
  ],
  "exclude": [
    "node_modules"
  ],
  "references": [
    {
      "path": "../../ui-kit"
    },
    {
      "path": "../../utils"
    },
    {
      "path": "../types"
    }
  ]
}
