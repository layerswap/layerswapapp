{
  "name": "@layerswap/ui-kit",
  "version": "1.5.0",
  "description": "Shared wallet connection contracts, registry, and UI.",
  "type": "module",
  "main": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "typings": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/esm/index.js"
    },
    "./types": {
      "types": "./dist/types/types/index.d.ts",
      "default": "./dist/esm/types/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./components": {
      "types": "./dist/types/components/index.d.ts",
      "default": "./dist/esm/components/index.js"
    }
  },
  "sideEffects": [
    "./dist/styles.css"
  ],
  "files": [
    "dist",
    "dist/**/*"
  ],
  "scripts": {
    "build": "pnpm run clean && pnpm run build:esm+types && pnpm run build:styles",
    "build:esm+types": "tsc --project tsconfig.json --rootDir ./src --outDir ./dist/esm --declaration --declarationMap --declarationDir ./dist/types && tsc-alias -p tsconfig.json --outDir ./dist/esm && tsc-alias -p tsconfig.json --outDir ./dist/types",
    "build:styles": "postcss ./src/components/styles.css -o dist/styles.css --config postcss.config.cjs --env production",
    "check:types": "tsc --noEmit",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "author": "Layerswap",
  "homepage": "https://github.com/layerswap/layerswapapp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/layerswap/layerswapapp.git",
    "directory": "packages/ui-kit"
  },
  "keywords": [
    "layerswap",
    "wallet",
    "wallet-connection"
  ],
  "license": "MIT",
  "dependencies": {
    "@layerswap/utils": "workspace:^",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "clsx": "^2.1.1",
    "copy-to-clipboard": "^3.3.3",
    "framer-motion": "^12.26.2",
    "lucide-react": "^0.379.0",
    "react-qrcode-logo": "4.1.0"
  },
  "peerDependencies": {
    "react": "^18.0 || ^19.0.0 || ^19.0.0-rc",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.15",
    "@types/react": "catalog:",
    "postcss": "^8.5.10",
    "postcss-cli": "^11.0.1",
    "postcss-prefixwrap": "^1.55.0",
    "react": "catalog:",
    "rimraf": "^5.0.0",
    "tailwindcss": "^4.0.15",
    "tailwindcss-animate": "^1.0.5",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.2",
    "zustand": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "bugs": {
    "url": "https://github.com/layerswap/layerswapapp/issues"
  }
}
