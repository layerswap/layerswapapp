    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Session \u00b7 ${session_id}",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "text",
            "version": "13.1.3",
            "spec": {
              "options": {
                "mode": "markdown",
                "content": "Expand the record for exact stored fields and stack, where available. Source-map attribution is unverified; a stack may still refer to minified code. Use the panel menu \u2192 Explore for deeper log inspection. Multiple records may share a stored timestamp."
              },
              "fieldConfig": {
                "defaults": {
                  "noValue": "\u2014"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Stored event",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "P8E80F9AEF21F6940"
                      },
                      "spec": {
                        "expr": "{source=\"faro\"} | logfmt | __error__=\"\" | label_format needle_application=`${application:percentencode}` | label_format needle_application=`{{ urldecode .needle_application }}` | label_format matched=`{{ (eq .app_name .needle_application) }}` | matched=\"true\" | label_format needle_release=`${release:percentencode}` | label_format needle_release=`{{ urldecode .needle_release }}` | label_format matched=`{{ or (eq .needle_release \"\") (eq .app_version .needle_release) }}` | matched=\"true\" | label_format deployment=`{{ if .page_attr_deployment_environment }}{{ .page_attr_deployment_environment }}{{ else }}unknown{{ end }}` | label_format needle_deployment=`${deployment:percentencode}` | label_format needle_deployment=`{{ urldecode .needle_deployment }}` | label_format matched=`{{ or (eq .needle_deployment \"\") (eq .deployment .needle_deployment) }}` | matched=\"true\" | label_format needle_session_id=`${session_id:percentencode}` | label_format needle_session_id=`{{ urldecode .needle_session_id }}` | label_format matched=`{{ (eq .session_id .needle_session_id) }}` | matched=\"true\" | session_id!=\"\" | label_format stored_ns=`ns:{{ __timestamp__ | unixEpochNanos }}` | label_format window_from=`{{ sub (unixEpochMillis (__timestamp__)) 300000 }}` | label_format window_to=`{{ add (unixEpochMillis (__timestamp__)) 300000 }}` | label_format needle_event_ns=`${event_ns:percentencode}` | label_format needle_event_ns=`{{ urldecode .needle_event_ns }}` | label_format needle_event_ns=`{{ if .needle_event_ns }}ns:{{ .needle_event_ns | trimPrefix \"ns:\" }}{{ end }}` | label_format matched=`{{ (eq .stored_ns .needle_event_ns) }}` | matched=\"true\"",
                        "queryType": "range",
                        "instant": false,
                        "range": true,
                        "direction": "backward",
                        "maxLines": 20,
                        "editorMode": "code"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "logs",
            "version": "13.1.3",
            "spec": {
              "options": {
                "showTime": true,
                "showLabels": false,
                "showCommonLabels": false,
                "wrapLogMessage": true,
                "enableLogDetails": true,
                "sortOrder": "Ascending",
                "dedupStrategy": "none"
              },
              "fieldConfig": {
                "defaults": {
                  "noValue": "\u2014"
                },
                "overrides": []
              }
            }
          }
        }
