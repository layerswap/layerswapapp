{
  "$schema": "https://unpkg.com/@changesets/config@3.1.1/schema.json",
  "changelog": "@changesets/cli/changelog",
  "commit": false,
  "fixed": [
    [
      "@layerswap/widget",
      "@layerswap/wallet-*",
      "@layerswap/wallets",
      "@layerswap/utils",
      "@layerswap/wallet-core",
      "@layerswap/ui-kit"
    ]
  ],
  "linked": [],
  "access": "public",
  "baseBranch": "dev",
  "updateInternalDependencies": "patch",
  "privatePackages": {
    "version": true,
    "tag": false
  },
  "ignore": [
    "@layerswap/bridge",
    "widget-playground",
    "layerswap-explorer",
    "widget-react-host-example",
    "@layerswap/widget-js",
    "@layerswap/widget-cdn",
    "@layerswap/widget-react"
  ],
  "snapshot": {
